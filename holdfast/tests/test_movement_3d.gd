extends "res://tests/test_support.gd"
func run() -> void:
	var preview = load("res://map_preview_3d.tscn").instantiate()
	root.add_child(preview)
	await process_frame
	var original = new_board("movement-reference")
	original.finish_opening()
	var squad_point: Vector2 = preview.camera.unproject_position(preview.world(Vector2i(3,8)))
	var enemy_point: Vector2 = preview.camera.unproject_position(preview.world(Vector2i(10,8)))
	expect(squad_point.y>enemy_point.y,"Squad is below enemy in the angled view")
	for i in range(4):
		preview.select_actor(i)
		original.select_soldier(i)
		for y in range(1,17):
			for x in range(1,21):
				var cell := Vector2i(x,y)
				var cost: int = original.move_cost(cell)
				expect(preview.display["reachable"].get(cell,0)==cost,"Reachable AP costs match production rules")
		var target := Vector2i(7,[6,7,9,10][i])
		preview.preview_route(target)
		expect(preview.display["path"]==original.path_to(target),"Hover route uses production path order")
		preview.activate_cell(target)
		expect(original.try_move(target),"Reference move succeeds")
		expect(preview.session.encounter.encounter_snapshot()==original.encounter_snapshot(),"3D move preserves exact production state")
		expect(preview.squad_models[i].position==preview.world(target),"3D model follows resolved logical position")
	preview.select_actor(0)
	var before: Dictionary = preview.session.encounter.encounter_snapshot()
	preview.activate_cell(Vector2i(12,5))
	expect(preview.session.encounter.encounter_snapshot()==before,"Blocked click spends no AP and changes no encounter data")
	preview.preview_route(Vector2i(8,6))
	var detached: Dictionary = preview.session.view()
	detached["soldiers"][0]["hp"] = -999
	expect(preview.session.encounter.soldiers[0]["hp"]==8,"Display snapshot cannot mutate live state")
	preview.reset_practice()
	expect(preview.session.encounter.soldiers[0]["cell"]==Vector2i(3,6) and preview.session.encounter.soldiers[0]["ap"]==2,"Reset restores starts and AP without a save")
	preview.select_actor(0)
	preview.preview_route(Vector2i(7,7))
	expect(preview.display["cost"]==2,"Long route previews a two-AP dash")
	preview.activate_cell(Vector2i(7,7))
	expect(preview.session.encounter.soldiers[0]["ap"]==0 and preview.display["reachable"].is_empty(),"Dash spends both AP and clears reachable highlights")
	var exhausted: Dictionary = preview.session.encounter.encounter_snapshot()
	preview.activate_cell(Vector2i(8,7))
	expect(preview.session.encounter.encounter_snapshot()==exhausted,"No movement is possible after AP is exhausted")
	preview.free()
	original.free()
	print("3D MOVEMENT FAILURES: ",failures)
	quit(1 if failures else 0)
